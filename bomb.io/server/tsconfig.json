{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "strict": true,
    "outDir": "dist",
    "skipLibCheck": true,
    "types": ["node", "jest"],
    "verbatimModuleSyntax": false
  },
  "include": ["src", "tests"]
}
